# ---- Shadoken server -------------------------------------------------------
PORT=2567

# ---- Run claim signing (RobinhoodChain) ------------------------------------
# Hot signer used ONLY to sign EIP-712 run claims. Never the deployer key.
RUN_CLAIM_SIGNER_PRIVATE_KEY=0x
# Master switch — the endpoint refuses to sign anything until this is "true".
RUN_CLAIM_SIGNING_ENABLED=false
ROBINHOODCHAIN_CHAIN_ID=
ARENA_POOL_ADDRESS=0x
SEASON_ID=1
# Keep at 0 until pool payouts are intentionally enabled. Badges work either way.
RUN_REWARD_WEI=0
RUN_CLAIM_TTL_SECONDS=3600
# Public origin used inside ERC1155 metadata (image URLs).
TOKEN_METADATA_BASE_URL=http://localhost:2567
