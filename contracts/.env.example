# ---- RobinhoodChain mainnet deployment -------------------------------------
ROBINHOODCHAIN_RPC_URL=
ROBINHOODCHAIN_CHAIN_ID=
# Deployer key — funds gas only. Keep it separate from owner/treasury/signer.
DEPLOYER_PRIVATE_KEY=0x
INITIAL_OWNER=0x
# MUST differ from the deployer: this is the server's hot run-claim signer.
RUN_CLAIM_SIGNER_ADDRESS=0x
TREASURY_ADDRESS=0x
TOKEN_BASE_URI=https://your-server.example/api/metadata/{id}.json
